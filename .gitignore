# Unreal Engine 5: generated files and local caches
# Keep Source/, Content/, Config/, Plugins/ source and the .uproject file in Git.

**/Binaries/
**/Intermediate/
**/DerivedDataCache/
**/Saved/

# Visual Studio / IDE local files
.vs/
.idea/
*.sln
*.suo
*.VC.db
*.VC.opendb
*.VC.db-shm
*.VC.db-wal
*.opensdf
*.sdf
*.user
*.userosscache
*.sln.docstates

# Local logs, crash dumps, temporary files
*.log
*.tmp
*.dmp

# Blender backup files (do not ignore .blend source files)
*.blend1
*.blend2

# Python caches from asset-generation scripts
__pycache__/
*.pyc

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Unreal Editor .uasset/.umap generated locally by the 1086 import/upgrade.
# Preserve on disk and in external Recovery_Backup, but do not stage as source.
# Ignores only generated versioned Build folders; hand-authored Content remains trackable.
/Content/Kotoden1086/Build_*/

# Local street meshes/levels generated from the user's geographic data snapshots
/Content/TakamatsuRoute/Stage01/Build_*/
